{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 2
  },
  "include": [],
  "configurePresets": [
    {
      "name": "mpi",
      "displayName": "GPU accelerated program",
      "cacheVariables": {
        "CMAKE_Fortran_COMPILER": "mpifort",
        "CMAKE_Fortran_FLAGS": "-stdpar=gpu -fast -Mconcur -Midiom -Mvect=simd -DBUILD_TYPE=\"'gpu'\"",
        "CMAKE_EXE_LINKER_FLAGS": "",
        "CMAKE_SHARED_LINKER_FLAGS": "",
        "GPU_BUILD": "ON",
        "DOC_CPU": "OFF"
      }
    },
    {
      "name": "accelerated",
      "displayName": "GPU accelerated program",
      "cacheVariables": {
        "CMAKE_Fortran_COMPILER": "nvfortran",
        "CMAKE_Fortran_FLAGS": "-stdpar=gpu -Minfo -DBUILD_TYPE=\"'gpu'\"",
        "CMAKE_EXE_LINKER_FLAGS": "",
        "CMAKE_SHARED_LINKER_FLAGS": "",
        "GPU_BUILD": "ON",
        "DOC_CPU": "OFF"
      }
    },
    {
      "name": "serial",
      "displayName": "Serial execution of the program",
      "cacheVariables": {
        "CMAKE_Fortran_COMPILER": "nvfortran",
        "CMAKE_Fortran_FLAGS": "-DBUILD_TYPE=\"'cpu'\"",
        "CMAKE_EXE_LINKER_FLAGS": "",
        "CMAKE_SHARED_LINKER_FLAGS": "",
        "GPU_BUILD": "OFF",
        "DOC_CPU": "OFF"
      }
    },
    {
      "name": "multicore",
      "displayName": "Serial execution of the program",
      "cacheVariables": {
        "CMAKE_Fortran_COMPILER": "nvfortran",
        "CMAKE_Fortran_FLAGS": "-stdpar=multicore -DBUILD_TYPE=\"'par'\"",
        "CMAKE_EXE_LINKER_FLAGS": "",
        "CMAKE_SHARED_LINKER_FLAGS": "",
        "GPU_BUILD": "OFF",
        "DOC_CPU": "OFF"
      }
    }
  ]
}
